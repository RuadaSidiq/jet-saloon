# ─── Core ────────────────────────────────────────────────────────────────
# PostgreSQL 14+ connection string (the app needs the btree_gist and pg_trgm extensions; migrations create them)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jetsaloon?sslmode=require"
# Public base URL, no trailing slash (used in emails, payment callbacks)
APP_URL="https://www.your-domain.com"
# 32 random bytes as 64 hex chars — encrypts payout account numbers. Generate: openssl rand -hex 32
# NEVER change it after go-live without re-encrypting existing data.
ENCRYPTION_KEY=""
# Shared secret for the HTTP cron endpoint (/api/cron). Generate: openssl rand -hex 24
CRON_SECRET=""
# Where uploaded files are stored when using the local storage driver (must be persistent, outside the web root)
STORAGE_DIR="/var/lib/jetsaloon/storage"

# ─── Payments ────────────────────────────────────────────────────────────
# Paystack: Dashboard → Settings → API Keys & Webhooks. Use sk_test_… in staging, sk_live_… in production.
PAYSTACK_SECRET_KEY=""
# Flutterwave (optional): secret key + the "secret hash" you set for webhooks
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""
# Development-only test gateway. Ignored when NODE_ENV=production.
PAYMENTS_DEV_GATEWAY="false"
DEV_GATEWAY_SECRET=""

# ─── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Muv <no-reply@your-domain.com>"

# ─── SMS (Hubtel, Ghana) ─────────────────────────────────────────────────
HUBTEL_SMS_CLIENT_ID=""
HUBTEL_SMS_CLIENT_SECRET=""
SMS_SENDER_ID="Muv"

# ─── First-run seed ──────────────────────────────────────────────────────
# Creates the first Super Admin when you run `npm run db:seed`. Remove after first run.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Demo providers/customers for local development only (never loads in production)
SEED_DEMO="false"
